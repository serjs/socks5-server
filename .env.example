PROXY_USER=someuser
PROXY_PASSWORD=somepass
REQUIRE_AUTH=true

PROXY_PORT=1080
PROXY_LISTEN_IP=0.0.0.0

MAX_CONNECTIONS=100
TIMEOUT=300

ALLOWED_DEST_FQDN=
ALLOWED_IPS=

# TLS settings (SOCKS5 over TLS)
TLS_ENABLED=false
TLS_PORT=10443
TLS_CERT_FILE=/path/to/cert.pem
TLS_KEY_FILE=/path/to/key.pem
TLS_MIN_VERSION=1.2

# Пример:
# ALLOWED_DEST_FQDN=^.*(example\.com|google\.com)$
# ALLOWED_IPS=192.168.1.10,10.0.0.5